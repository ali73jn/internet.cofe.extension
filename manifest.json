{
  "manifest_version": 3,
  "name": "همیار کافینت",
  "version": "24",
  "description": "مدیریت پیشرفته بوکمارک ها",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "chrome_url_overrides": {
    "newtab": "dashboard.html"
  },

  "permissions": [
    "storage",
    "bookmarks",
    "tabs",
    "downloads",
    "scripting",
    "contextMenus"
  ],

  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file:///*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://web.rubika.ir/*",
        "https://web.eitaa.com/*",
        "https://web.shad.ir/*",
        "https://shadweb.iranlms.ir/*",
        "https://web.bale.ai/*"
      ],
      "js": ["print_help/main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.rubika.ir/*",
        "https://web.eitaa.com/*",
        "https://web.shad.ir/*",
        "https://shadweb.iranlms.ir/*",
        "https://web.bale.ai/*"
      ],
      "js": ["print_help/content.js"],
      "css": ["print_help/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["print_help/context-image.js"],
      "css": ["print_help/content.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "PerspectiveCrop/index.html",
        "PerspectiveCrop/libs/opencv.js",
        "print_help/editor.html",
        "print_help/editor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}